{
  "expo": {
    "name": "Repo Nexus",
    "slug": "repo-nexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "reponexus",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reponexus.ios",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["reponexus"]
          }
        ],
        "NSFaceIDUsageDescription": "We use Face ID to securely authenticate you.",
        "NSCameraUsageDescription": "We need camera access to scan QR codes."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "repo-nexus-project"
      }
    }
  }
}

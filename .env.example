# Repo Nexus Frontend Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL
# Development (iOS Simulator): http://localhost:8000
# Development (Android Emulator): http://10.0.2.2:8000
# Development (Physical Device): http://<YOUR_LOCAL_IP>:8000
# Production: https://api.reponexus.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (for real-time features)
# Development (iOS Simulator): ws://localhost:8000
# Development (Android Emulator): ws://10.0.2.2:8000
# Development (Physical Device): ws://<YOUR_LOCAL_IP>:8000
# Production: wss://api.reponexus.com
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# AUTHENTICATION
# =============================================================================

# GitHub OAuth Client ID
# Get this from: https://github.com/settings/developers
# For development, create an OAuth App with:
# - Homepage URL: http://localhost:8081
# - Authorization callback URL: reponexus://callback
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment: development | staging | production
NODE_ENV=development

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable features
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_ERROR_REPORTING=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

# =============================================================================
# DEBUGGING (Optional)
# =============================================================================

# Enable debug logging
EXPO_PUBLIC_DEBUG=false
EXPO_PUBLIC_DEBUG_API=false
EXPO_PUBLIC_DEBUG_NETWORK=false

# =============================================================================
# NOTES
# =============================================================================

# Platform-Specific URLs:
# - iOS Simulator uses localhost (127.0.0.1)
# - Android Emulator uses 10.0.2.2 (maps to host machine's 127.0.0.1)
# - Physical devices need your local network IP (e.g., 192.168.1.100)
#
# To find your local IP:
# - macOS/Linux: ifconfig | grep "inet "
# - Windows: ipconfig
#
# The app will automatically handle platform-specific URLs if you set
# EXPO_PUBLIC_API_URL to your base URL without the platform-specific part.

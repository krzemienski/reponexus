{
  "expo": {
    "name": "Repo Nexus",
    "slug": "repo-nexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "reponexus",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reponexus.ios",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["reponexus"]
          }
        ],
        "NSFaceIDUsageDescription": "We use Face ID to securely authenticate you.",
        "NSCameraUsageDescription": "We need camera access to scan QR codes."
      }
    },
    "android": {
      "package": "com.reponexus.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "reponexus",
              "host": "callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "repo-nexus-project"
      },
      "EXPO_PUBLIC_API_URL": "${EXPO_PUBLIC_API_URL}",
      "EXPO_PUBLIC_WS_URL": "${EXPO_PUBLIC_WS_URL}",
      "EXPO_PUBLIC_GITHUB_CLIENT_ID": "${EXPO_PUBLIC_GITHUB_CLIENT_ID}"
    }
  }
}

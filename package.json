{
  "name": "repo-nexus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html --coverageReporters=lcov",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "detox test -c ios.sim.release",
    "test:e2e:build": "detox build -c ios.sim.release",
    "test:maestro": "maestro test .maestro/",
    "test:maestro:critical": "maestro test .maestro/critical-journey.yaml",
    "test:all": "npm run test:coverage && npm run lint && npm run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.75.4",
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "react-native-safe-area-context": "4.11.0",
    "react-native-screens": "~4.1.0",
    "nativewind": "^5.0.0",
    "react-native-reanimated": "~4.0.0",
    "react-native-gesture-handler": "~2.20.0",
    "@shopify/flash-list": "1.7.1",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "@react-native-community/netinfo": "^11.3.0",
    "zustand": "^5.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-mmkv": "^3.0.0",
    "axios": "^1.7.0",
    "@apollo/client": "^3.11.0",
    "graphql": "^16.9.0",
    "expo-auth-session": "~6.0.0",
    "expo-crypto": "~14.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-web-browser": "~14.0.0",
    "react-native-css": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@testing-library/react-native": "^12.7.0",
    "@testing-library/jest-native": "^5.4.3",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.75.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.6.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "private": true
}
